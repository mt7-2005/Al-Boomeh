@baseUrl = https://localhost:7027

### ========================================
### 1. Admin Login
### ========================================

# @name adminLogin
POST {{baseUrl}}/api/Auth/login
Content-Type: application/json

{
  "email": "mohamad.kisswani@al-boomeh.com",
  "password": "123456"
}

###

@adminToken = {{adminLogin.response.body.$.accessToken}}

### ========================================
### 2. Get Stores
### ========================================

GET {{baseUrl}}/api/Stores/All?pagenumber=5&pagesize=10
Authorization: Bearer {{adminToken}}

### ========================================
### 3. Request Customer OTP
### ========================================

POST {{baseUrl}}/api/Auth/RequestOtp?phone=0791482276

### ========================================
### 4. Verify Customer OTP
### ========================================

# Get the OTP from the API logs and replace the value below.

# @name customerVerify
POST {{baseUrl}}/api/Auth/Verify?phone=0791482276&code=362270

###

@customerToken = {{customerVerify.response.body.$.accessToken}}

### ========================================
### 5. Create Customer Order
### ========================================

# @name createOrder
POST {{baseUrl}}/api/Orders
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "customerId": 7,
  "storeId": 7,
  "orderLines": [
    {
      "id": 0,
      "customerId": 7,
      "productId": 7,
      "quantity": 1,
      "notes": "string",
      "extraId": 0
    }
  ]
}

###

@orderId = {{createOrder.response.body.$.id}}

### ========================================
### 6. Place Order
### ========================================

# Expect: 200

PUT {{baseUrl}}/api/Orders?id={{orderId}}
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "type": 0,
  "paymentMethod": 1,
  "customerId": 7,
  "addressId": 0,
  "tips": 0,
  "storeNotes": "string",
  "driverNotes": "string",
  "latitude": "string",
  "longitude": "string",
  "voucherCode": "string",
  "driverInstructions": "string"
}

### ========================================
### 7. Partner (Store) Login
### ========================================

# @name partnerLogin
POST {{baseUrl}}/api/Auth/login
Content-Type: application/json

{
  "email": "partner@al-boomeh.com",
  "password": "123456"
}

###

@partnerToken = {{partnerLogin.response.body.$.accessToken}}

### ========================================
### 8. Order Status -> Accepted (1)
### ========================================

# Expect: 200

PUT {{baseUrl}}/api/Orders/{{orderId}}/updatestatus
Authorization: Bearer {{partnerToken}}
Content-Type: application/json

{
  "status": 1,
  "storeId": 0
}

### ========================================
### 9. Order Status -> Preparing (2)
### ========================================

# Expect: 200

PUT {{baseUrl}}/api/Orders/{{orderId}}/updatestatus
Authorization: Bearer {{partnerToken}}
Content-Type: application/json

{
  "status": 2,
  "storeId": 0
}

### ========================================
### 10. Order Status -> OutForDelivery (3)
### ========================================

# Expect: 200

PUT {{baseUrl}}/api/Orders/{{orderId}}/updatestatus
Authorization: Bearer {{partnerToken}}
Content-Type: application/json

{
  "status": 3,
  "storeId": 0
}

### ========================================
### 11. Order Status -> Delivered (4)
### ========================================

# Expect: 200

PUT {{baseUrl}}/api/Orders/{{orderId}}/updatestatus
Authorization: Bearer {{partnerToken}}
Content-Type: application/json

{
  "status": 4,
  "storeId": 0
}

### ========================================
### 12. View Order Details (as Customer)
### ========================================

# Expect: 200, and the status in the response should be Delivered (4).

GET {{baseUrl}}/api/Orders/{{orderId}}
Authorization: Bearer {{customerToken}}

### ========================================
### 13. View Store Dashboard (as Partner)
### ========================================

# Expect: 200. Check that the delivered order is reflected in the numbers.

GET {{baseUrl}}/api/Stores/5
Authorization: Bearer {{partnerToken}}

### ========================================
### Security checks (optional, for docs/attack-log.md)
### ========================================

### S1. Customer tries to change order status. Expect: 403

PUT {{baseUrl}}/api/Orders/{{orderId}}/updatestatus
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "status": 4,
  "storeId": 0
}

### S2. Order details with no token. Expect: 401


